# Copy to .env and fill in. Never commit .env.

# Gemini 2.5 Pro (optional): deck extraction and objections. Without it Groq does both.
AUTOPITCH_GEMINI_API_KEY=

# Llama 3.1 for section scoring, via any OpenAI-compatible endpoint (Groq shown)
AUTOPITCH_LLAMA_BASE_URL=https://api.groq.com/openai/v1
AUTOPITCH_LLAMA_API_KEY=
AUTOPITCH_LLAMA_MODEL=llama-3.1-70b-versatile

# Embeddings for the SEC benchmark. Voyage gives 200M free tokens (dash.voyageai.com).
# "auto" uses Voyage if its key is set, else Gemini.
AUTOPITCH_VOYAGE_API_KEY=
AUTOPITCH_EMBEDDING_PROVIDER=auto
AUTOPITCH_EMBEDDING_DIM=1024

# Pinecone index of SEC-derived funding rounds (optional: without it the benchmark step is skipped).
# Its dimension must equal AUTOPITCH_EMBEDDING_DIM; use a new name if you change models.
AUTOPITCH_PINECONE_API_KEY=
AUTOPITCH_PINECONE_INDEX=autopitch-filings-1024

# SEC EDGAR requires a User-Agent identifying you, e.g. "Jane Doe jane@example.com"
AUTOPITCH_SEC_USER_AGENT=

# LangSmith tracing (optional; enabling it sends prompt content to LangSmith)
AUTOPITCH_LANGSMITH_API_KEY=
AUTOPITCH_LANGSMITH_PROJECT=autopitch

# API hardening
AUTOPITCH_API_KEY=
AUTOPITCH_MAX_UPLOAD_MB=25
AUTOPITCH_MAX_PAGES=60
AUTOPITCH_RATE_LIMIT_PER_MINUTE=10
# Section scorers in flight at once; keep low on a free-tier Groq token-per-minute cap
AUTOPITCH_SCORING_CONCURRENCY=2

# OCR for image-only decks (Mistral OCR). Comma-separated keys are rotated when one hits its limit.
# Without keys, image-only decks are rejected. Set AUTOPITCH_OCR_ENABLED=false to turn OCR off.
AUTOPITCH_MISTRAL_API_KEYS=
AUTOPITCH_OCR_ENABLED=true
